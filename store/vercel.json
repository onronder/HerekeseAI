{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/mesafeli-satis", "destination": "/yasal#mesafeli-satis" },
    { "source": "/teslimat-iade", "destination": "/yasal#teslimat-iade" },
    { "source": "/gizlilik", "destination": "/yasal#kvkk" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
