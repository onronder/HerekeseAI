// Kapak yayılımı (arka + sırt + ön) → out/kapak.html; kapak.json'dan ölçü ve metin. node kapak.mjs
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createRequire } from 'node:module';
const require = createRequire(import.meta.url);
const HERE = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.resolve(HERE, '..', '..');
const cfg = JSON.parse(fs.readFileSync(path.join(HERE, 'kapak.json'), 'utf8'));
const W = 160, H = 240, BLEED = 5, SP = Number(cfg.spine_mm);
const TOTAL_W = 2 * W + SP + 2 * BLEED, TOTAL_H = H + 2 * BLEED;

// EAN-13 barkod (ISBN verildiyse); yoksa yer tutucu kutu
let barcode = `<div class="isbn-ph">ISBN barkodu<br><small>[YENİ ISBN] geldiğinde kapak.json → isbn</small></div>`;
const digits = String(cfg.isbn || '').replace(/[^0-9]/g, '');
if (digits.length === 13) {
  const { DOMImplementation, XMLSerializer } = require('@xmldom/xmldom');
  const JsBarcode = require('jsbarcode');
  const doc = new DOMImplementation().createDocument('http://www.w3.org/1999/xhtml', 'html', null);
  const svg = doc.createElementNS('http://www.w3.org/2000/svg', 'svg');
  JsBarcode(svg, digits, { xmlDocument: doc, format: 'EAN13', width: 2, height: 60, fontSize: 14, margin: 6, background: '#ffffff', lineColor: '#000000' });
  const s = new XMLSerializer().serializeToString(svg);
  barcode = `<div class="isbn"><div class="isbn-no">ISBN ${cfg.isbn}</div>${s}</div>`;
}
const fonts = fs.readFileSync(path.join(ROOT, 'store', 'assets', 'fonts.css'), 'utf8')
  .replaceAll('url(fonts/', `url(file://${path.join(ROOT, 'store', 'assets', 'fonts')}/`);
const paras = cfg.back_text.map(p => `<p>${p}</p>`).join('');
const html = `<!doctype html><html lang="tr"><head><meta charset="utf-8"><title>Kapak</title>
<style>
${fonts}
@page { size: ${TOTAL_W}mm ${TOTAL_H}mm; margin: 0; }
html, body { margin: 0; padding: 0; }
body { width: ${TOTAL_W}mm; height: ${TOTAL_H}mm; background: #f4efe6; color: #000; font-family: 'Work Sans', sans-serif; position: relative; overflow: hidden; }
.panel { position: absolute; top: 0; height: ${TOTAL_H}mm; box-sizing: border-box; }
.back  { left: 0; width: ${BLEED + W}mm; padding: ${BLEED + 18}mm ${16}mm ${BLEED + 16}mm ${BLEED + 16}mm; }
.spine { left: ${BLEED + W}mm; width: ${SP}mm; background: #e85d3a; color: #fff; }
.front { left: ${BLEED + W + SP}mm; width: ${W + BLEED}mm; padding: ${BLEED + 22}mm ${BLEED + 16}mm ${BLEED + 16}mm 16mm; background: #e85d3a; color: #fff; }
.front .eyebrow, .back .eyebrow { font-family: 'Space Mono', monospace; font-size: 8.5pt; letter-spacing: .18em; text-transform: uppercase; }
.front h1 { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: 46pt; line-height: 1.02; margin: 14mm 0 6mm; }
.front .sub { font-family: 'Instrument Serif', serif; font-size: 18pt; font-style: italic; margin: 0 0 30mm; }
.front .author { position: absolute; bottom: ${BLEED + 18}mm; left: 16mm; font-family: 'Space Mono', monospace; font-size: 11pt; letter-spacing: .14em; text-transform: uppercase; }
.front .mark { position: absolute; bottom: ${BLEED + 18}mm; right: ${BLEED + 16}mm; width: 34mm; height: 34mm; border: 1.2pt solid #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Instrument Serif', serif; font-size: 22pt; }
.spine .t { position: absolute; top: ${BLEED + 14}mm; left: 50%; transform: translateX(-50%) rotate(90deg); transform-origin: left top; white-space: nowrap; font-family: 'Instrument Serif', serif; font-size: ${Math.min(14, SP * 0.9)}pt; }
.spine .a { position: absolute; bottom: ${BLEED + 14}mm; left: 50%; transform: translateX(-50%) rotate(90deg); transform-origin: left bottom; white-space: nowrap; font-family: 'Space Mono', monospace; font-size: ${Math.min(8, SP * 0.5)}pt; letter-spacing: .12em; text-transform: uppercase; }
.back p { font-size: 10pt; line-height: 1.5; margin: 0 0 .8em; text-align: justify; hyphens: auto; }
.back .bio { font-size: 8.5pt; color: #37332a; margin-top: 8mm; border-top: .5pt solid #8a8270; padding-top: 3mm; }
.back .bottom { position: absolute; bottom: ${BLEED + 14}mm; left: ${BLEED + 16}mm; right: 16mm; display: flex; justify-content: space-between; align-items: flex-end; }
.back .seller { font-family: 'Space Mono', monospace; font-size: 7pt; color: #37332a; max-width: 62mm; }
.isbn, .isbn-ph { background: #fff; padding: 2mm; border: .4pt solid #8a8270; font-family: 'Space Mono', monospace; font-size: 7.5pt; text-align: center; }
.isbn-ph { width: 40mm; height: 24mm; display: flex; flex-direction: column; justify-content: center; color: #8a8270; }
.isbn svg { display: block; width: 38mm; height: auto; }
.qrhint { font-family: 'Space Mono', monospace; font-size: 7.5pt; letter-spacing: .06em; color: #37332a; margin-top: 4mm; }
</style></head><body>
<div class="panel back">
  <div class="eyebrow">Kuraldan derin öğrenmeye</div>
  <div style="margin-top:8mm">${paras}</div>
  <div class="qrhint">45 canlı demo · her şeklin altında QR · giriş gerekmez</div>
  <div class="bio">${cfg.author_bio}</div>
  <div class="bottom"><div class="seller">${cfg.seller}${cfg.price ? ` · ${cfg.price}` : ''}</div>${barcode}</div>
</div>
<div class="panel spine"><div class="t">Herkes İçin Yapay Zekâ</div><div class="a">Onur Önder</div></div>
<div class="panel front">
  <div class="eyebrow">Kuraldan derin öğrenmeye</div>
  <h1>Herkes İçin<br>Yapay Zekâ</h1>
  <div class="sub">8 bölüm · 45 deney · kâğıtta ve telefonda</div>
  <div class="author">Onur Önder</div>
  <div class="mark">YZ</div>
</div>
</body></html>`;
fs.mkdirSync(path.join(HERE, 'out'), { recursive: true });
fs.writeFileSync(path.join(HERE, 'out', 'kapak.html'), html);
console.log(`out/kapak.html · yayılım ${TOTAL_W}×${TOTAL_H} mm (sırt ${SP} mm, taşma ${BLEED} mm) · barkod: ${digits.length === 13 ? 'EAN-13' : 'yer tutucu'}`);
